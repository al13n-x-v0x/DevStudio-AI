# DevStudio AI Environment Variables
# Copy this to .env and fill in your keys

# Nebius Token Factory (NVIDIA Nemotron)
# Get free credits with code: NEBIUS-DEVPOST-GLOBAL26
NEBIUS_API_KEY=your-nebius-api-key
NEBIUS_API_BASE=https://staging.api.nebius.ai/v1
NEBIUS_REASONING_MODEL=nvidia/nemotron-3-ultra
NEBIUS_FAST_MODEL=nvidia/nemotron-nano-12b-2-v1
NEBIUS_CODE_MODEL=nvidia/nemotron-super-49b-v1

# Tavily Web Search (for real-time search in chat)
# Get free key at https://tavily.com (1,000 free credits/month)
TAVILY_API_KEY=tvly-your-tavily-api-key
